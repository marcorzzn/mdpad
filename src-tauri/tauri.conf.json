{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDPad",
  "version": "1.0.0",
  "identifier": "com.marcorazzano.mdpad",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MDPad — Blocco Note Markdown",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg"],
    "publisher": "Marco Razzano",
    "copyright": "Copyright (c) 2026 Marco Razzano — MIT License",
    "shortDescription": "Blocco Note Markdown cross-platform con MarkItDown offline e Post-it cartelle",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Documento Markdown",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["txt", "log", "json"],
        "name": "Documento di Testo",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ]
  }
}
