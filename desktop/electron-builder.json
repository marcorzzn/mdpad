{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.github.mdpad.editor",
  "productName": "MDPad",
  "asar": true,
  "compression": "normal",
  "directories": {
    "output": "../release-desktop"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "fileArgs.cjs",
    "server-bundle.cjs",
    "assets/**"
  ],
  "extraResources": [
    {
      "from": "../dist",
      "to": "dist",
      "filter": ["**/*"]
    },
    {
      "from": "../public/samples",
      "to": "public/samples",
      "filter": ["**/*"]
    }
  ],
  "fileAssociations": [
    {
      "ext": ["md", "markdown"],
      "name": "Markdown Document",
      "description": "Documento Markdown (MDPad)",
      "icon": "assets/icon.ico"
    }
  ],
  "win": {
    "icon": "assets/icon.ico",
    "artifactName": "MDPad-Windows-${version}-x64.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MDPad",
    "runAfterFinish": true,
    "artifactName": "MDPad-Setup-${version}-x64.exe"
  },
  "portable": {
    "artifactName": "MDPad-Portable-${version}-x64.exe"
  }
}
