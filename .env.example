# MarkItDown Web & MCP Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Enable MarkItDown plugin support flag (preserved from markitdown-mcp)
MARKITDOWN_ENABLE_PLUGINS=false

# Optional: Azure Document Intelligence & Content Understanding endpoints (if integrating cloud OCR)
MARKITDOWN_DOCINTEL_ENDPOINT=
MARKITDOWN_CU_ENDPOINT=
AZURE_API_KEY=

# Optional: System binary paths (from original Dockerfile)
EXIFTOOL_PATH=/usr/bin/exiftool
FFMPEG_PATH=/usr/bin/ffmpeg
